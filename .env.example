# Copia este archivo como ".env" (en la misma carpeta que manage.py) y elige UNA opción de MONGO_URI.
# El archivo .env no se sube a GitHub (.gitignore lo excluye).

# Opción A — MongoDB Atlas (gratis, ya es replica set). Pega la cadena que te da Atlas:
# MONGO_URI=mongodb+srv://USUARIO:CONTRASENA@CLUSTER.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Opción B — Docker (docker compose up -d) o MongoDB instalado en tu PC con replica set rs0:
MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true

# Nombre de la base. Las pruebas usan otra base aparte: test_<este nombre>.
MONGO_DB_NAME=reservas_upb
